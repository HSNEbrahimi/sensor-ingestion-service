{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=sensor.db"
  },
  "Ingestion": {
    "ReadingsPath": "readings.jsonl",
    "RulesPath": "rules.json",
    "CooldownMinutes": 5,
    "RunOnStartup": true
  }
}